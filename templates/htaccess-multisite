# WordPress Multisite .htaccess
# Apache 2.4 syntax

# Disable directory listings
Options -Indexes

# Deny direct access to dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Preserve Authorization header for REST/auth if proxies or FastCGI are used
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteBase /

    # Block PHP-family execution in writable data folders
    RewriteRule ^wp-content/(uploads|cache|upgrade|backups|languages)/.*\.(?i:php[0-9]?|phtml|phar|pht)$ - [F]

    # Block direct HTTP execution of PHP in wp-includes
    RewriteRule ^wp-includes/.*\.(?i:php[0-9]?|phtml|phar|pht)$ - [F]

    # Multisite: enforce trailing slash on wp-admin
    RewriteRule ^([_0-9a-zA-Z-]+/)?wp-admin$ $1wp-admin/ [R=301,L]

    # Multisite front controller
    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^([_0-9a-zA-Z-]+/)(wp-(content|admin|includes).*) $2 [L]
    RewriteRule ^([_0-9a-zA-Z-]+/)(.*\.php)$ $2 [L]
    RewriteRule . index.php [L]
</IfModule>
